{
  "name": "@openedu/print",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist"
  },
  "license": "MIT",
  "dependencies": {
    "@openedu/content": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./print.css": "./src/print.css"
  },
  "files": [
    "dist",
    "src/print.css"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./print.css": "./src/print.css"
    }
  }
}
