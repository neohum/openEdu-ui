{
  "name": "@openedu/ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run --passWithNoTests",
    "build": "tsup src/index.ts --format esm --dts --clean --out-dir dist"
  },
  "license": "MIT",
  "dependencies": {
    "@openedu/core": "workspace:^",
    "perfect-freehand": "^1.2.3"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "jsdom": "^30.1.1"
  }
}
