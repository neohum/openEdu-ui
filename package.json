{
  "name": "openedu-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.0",
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p .",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "lint:tokens": "node scripts/ops/spacing-lint.ts",
    "test:scripts": "node --test scripts/ops/spacing-lint.test.ts",
    "print:sample": "tsx scripts/ops/print-pdf.ts --sample",
    "capture": "pnpm --filter showcase build && tsx scripts/ops/capture-showcase.ts",
    "pack:check": "pnpm -r --filter \"./packages/*\" exec pnpm pack --pack-destination ../../out/pack"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@rolldown/binding-darwin-arm64": "^1.2.12",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "pdfjs-dist": "^6.3.289",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT"
}
